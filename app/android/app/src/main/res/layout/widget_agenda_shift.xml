<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/widget_agenda_shift_height"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <FrameLayout
        android:id="@+id/agenda_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/widget_agenda_chip_width"
        android:layout_marginEnd="@dimen/widget_space_s">
        <ImageView
            android:id="@+id/agenda_chip_tint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cell"
            android:importantForAccessibility="no"/>
        <TextView
            android:id="@+id/agenda_shift_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/widget_agenda_chip_width"
            android:gravity="center"
            android:paddingLeft="@dimen/widget_chip_inset"
            android:paddingRight="@dimen/widget_chip_inset"
            android:paddingTop="@dimen/widget_shift_bar_height"
            android:paddingBottom="@dimen/widget_shift_bar_height"
            android:textSize="@dimen/widget_label_size"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary"/>
        <ImageView
            android:id="@+id/agenda_shift_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_shift_bar_height"
            android:layout_gravity="bottom"
            android:src="@drawable/widget_pill"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <TextView
        android:id="@+id/agenda_shift_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="@dimen/widget_label_size"
        android:textColor="@color/widget_text_secondary"/>
</LinearLayout>
