<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tw_cell"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_margin="@dimen/widget_space_xxs">
    <ImageView
        android:id="@+id/tw_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_month_cell"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/widget_space_xxs"
        android:background="@color/widget_surface"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tw_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textSize="@dimen/widget_cell_time_size"
            android:textColor="@color/widget_text_secondary"/>
        <LinearLayout
            android:id="@+id/tw_shifts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/tw_note"
        android:layout_width="@dimen/widget_space_s"
        android:layout_height="@dimen/widget_space_s"
        android:layout_gravity="top|end"
        android:src="@drawable/widget_note"
        android:contentDescription="@string/widget_has_note"
        android:visibility="gone"/>
</FrameLayout>
