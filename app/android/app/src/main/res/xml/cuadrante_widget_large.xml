<?xml version="1.0" encoding="utf-8"?>
<!-- 4x4 widget: the month grid. Resizable down to about 3x3 cells. The same
     safety nets as the other widgets (midnight alarm, system broadcasts,
     WorkManager, updatePeriodMillis) keep it on the right day and month. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_large_description"
    android:initialLayout="@layout/widget_month"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="180dp"
    android:previewImage="@drawable/widget_preview_large"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
